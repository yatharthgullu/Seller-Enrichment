# Copy to .env (git-ignored) and fill in. Nothing here is needed for upload,
# triage, accuracy or the explorer; it is only for the Sarvam voice-call panel.

# Sarvam Voice Agents (call results: "Fetch latest calls", webhook, place call)
SARVAM_APPS_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_AGENT_ID=

# Only used to transliterate Hindi replies
SARVAM_API_KEY=

# Only for receiving results by webhook (public URL + shared token)
WEBHOOK_URL=
WEBHOOK_TOKEN=
